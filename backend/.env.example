# Copy this file to .env and fill in your values

# Supabase / PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Auth
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - add your frontend URL
FRONTEND_URL=http://localhost:5173

# App
APP_NAME=NUP Diaspora Convention 2026 — Los Angeles
CONFERENCE_START_DATE=2026-08-12
CONFERENCE_END_DATE=2026-08-16

# Stripe Webhook
# Get this from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Endpoint URL must be the API host (Render), NOT the frontend:
#   https://conventions.onrender.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Payment Link IDs — use the plink_… ID from Stripe Dashboard → Payment Links
# (open a link; the URL contains /payment-links/plink_xxx). NOT the buy.stripe.com slug.
STRIPE_LINK_CONVENTION_FULL=plink_...
STRIPE_LINK_CONVENTION_HALF=plink_...
STRIPE_LINK_CONVENTION_CHILDREN=plink_...
STRIPE_LINK_BOAT_CRUISE_FULL=plink_...
STRIPE_LINK_BOAT_CRUISE_PARTIAL=plink_...
STRIPE_LINK_VENDOR=plink_...
